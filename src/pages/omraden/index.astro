---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import PostcodeCheck from '../../components/PostcodeCheck.astro';
import CtaBand from '../../components/CtaBand.astro';
import Icon from '../../components/Icon.astro';
import { areasByCounty } from '../../data/areas.js';
import { site } from '../../config/site.js';
---
<Base
  title="Flytt och städning i Stockholms, Uppsala och Södermanlands län"
  description="Vi flyttar och städar i alla kommuner i Stockholms, Uppsala och Södermanlands län, från Norrtälje till Nyköping. Välj din ort eller kolla ditt postnummer."
  breadcrumbs={[{ name: 'Områden', href: '/omraden' }]}
>
  <section class="section section--tight">
    <div class="container split">
      <div>
        <Breadcrumbs items={[{ name: 'Områden', href: '/omraden' }]} />
        <h1>Flytt och städning i tre län</h1>
        <p class="lead">
          Vi utgår från {site.address.city} och kör i alla kommuner i Stockholms län, Uppsala län och Södermanlands län. Välj din ort för lokala tips, eller skriv ditt postnummer för att kolla direkt.
        </p>
      </div>
      <PostcodeCheck />
    </div>
  </section>
  {areasByCounty.map((c, ci) => (
  <section class:list={['section', ci % 2 === 0 ? 'section--white' : '']} id={c.key}>
    <div class="container">
      <h2 class="county">{c.name}</h2>
      <ul class="areas">
        {
          c.areas.map((a) => (
            <li>
              <a href={`/omraden/${a.slug}`} class="card">
                <h2 class="h3">
                  <Icon name="map" /> {a.name}
                </h2>
                <p>{a.intro}</p>
                <span class="more">
                  Flytt och städ i {a.name} <Icon name="arrow" />
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
  ))}
  <CtaBand />
</Base>

<style>
  .county {
    margin: 0 0 20px;
  }
  .areas {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
  }
  .areas a {
    display: flex;
    flex-direction: column;
    height: 100%;
    text-decoration: none;
    color: inherit;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .areas a:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow);
  }
  .h3 {
    font-size: 1.25rem;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .h3 :global(svg) {
    width: 22px;
    height: 22px;
    color: var(--green-700);
  }
  .areas p {
    color: var(--ink-2);
  }
  .more {
    margin-top: auto;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-weight: 650;
    color: var(--green-700);
  }
  .more :global(svg) {
    width: 18px;
    height: 18px;
  }
</style>
