---
import { Picture } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import ContactForm from '../../components/ContactForm.astro';
import { site } from '../../config/site.js';
import { PRICES, movePrice, formatKr } from '../../lib/pricing.js';
import { img } from '../../lib/images.js';

const p = site.promises;
const twoRoom = movePrice({ size: '2', distanceKm: 10 });
const services = [
  { icon: 'truck', title: 'Moving help', text: `From ${PRICES.flytt.crews['2-1'].weekday} SEK/hour for 2 movers and a truck after the RUT deduction.`, href: '/flyttfirma' },
  { icon: 'sparkle', title: 'Move out cleaning', text: `${PRICES.flyttstadning.perSqm} SEK per m² after RUT, with a photo report and an inspection guarantee for ${p.inspectionGuaranteeDays} days.`, href: '/flyttstadning' },
  { icon: 'box', title: 'Moving + cleaning package', text: `One team, one invoice and ${Math.round(p.packageDiscount * 100)} % off the cleaning.`, href: '/flytt-och-flyttstadning' },
  { icon: 'home', title: 'Home cleaning', text: `${PRICES.hemstadning.perHour} SEK/hour after RUT. No binding contract, and the same cleaner whenever possible.`, href: '/hemstadning' },
  { icon: 'window', title: 'Window cleaning', text: `${PRICES.fonsterputs.window2} SEK per window after RUT.`, href: '/fonsterputs' },
  { icon: 'building', title: 'Office cleaning & office moves', text: `${PRICES.kontorsstadning.perHourExVat} SEK/hour excl. VAT for cleaning.`, href: '/kontorsstadning' },
];
const guarantees = [
  ['tag', 'A fixed price that holds', 'The price we confirm is the price you pay, as long as the details you gave are correct. No surprise fees on the day.'],
  ['camera', 'Photo report', 'Timestamped photos of every room after the move out cleaning. Your proof if the landlord gets in touch later.'],
  ['shield', `Inspection guarantee, ${p.inspectionGuaranteeDays} days`, `If the inspection finds anything, we come back and fix it free of charge within ${p.inspectionFixHours} hours.`],
  ['phone', 'We let you know when we are on our way', 'A booking confirmation by email, and on the day we call or text when we leave. No waiting by the window.'],
  ['card', 'Pay afterwards', `No prepayment. The invoice arrives when the job is done, with the RUT deduction already applied.`],
  ['alert', 'Simple damage claims', `Report with photos online. Answer within ${p.damageResponseHours} hours. Insured with ${site.insurer}.`],
];
---
<Base
  title="Movers and cleaners in Stockholm, fixed price | TO Städ & Flytt"
  description="Moving help and move out cleaning in Stockholm at a fixed price after the RUT deduction. Photo report, inspection guarantee and you pay afterwards."
  lang="en"
  image={img('stockholm')}
  imageAlt="Stockholm seen from the water"
  alternates={[
    { lang: 'sv', href: '/' },
    { lang: 'en', href: '/en' },
    { lang: 'x-default', href: '/' },
  ]}
>
  <section class="section en-hero">
    <div class="container split">
      <div>
        <p class="eyebrow"><Icon name="globe" /> English</p>
        <h1>Moving and cleaning in Stockholm at a fixed price</h1>
        <p class="lead">
          New to Sweden or just prefer English? We move your home, clean the old one so it passes the landlord's inspection, and handle the Swedish RUT tax
          deduction for you. We cover all of Stockholm, Uppsala and Södermanland counties.
        </p>
        <div class="btn-row">
          <a class="btn" href="#contact">Get a fixed price <Icon name="arrow" /></a>
          <a class="btn btn--whatsapp" href={site.whatsappHref} rel="noopener"><Icon name="whatsapp" /> WhatsApp us</a>
        </div>
      </div>
      <div class="media">
        <Picture src={img('stockholm')} alt="Stockholm seen from the water on a sunny day" formats={['avif', 'webp']} widths={[480, 800]} sizes="(min-width: 900px) 45vw, 100vw" loading="eager" />
      </div>
    </div>
  </section>

  <section class="section section--white" id="services">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Services</p>
        <h2>Everything for your move</h2>
      </div>
      <div class="grid grid-3">
        {
          services.map((s) => (
            <a class="card svc" href={s.href} hreflang="sv">
              <span class="icon-badge">
                <Icon name={s.icon} />
              </span>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
              <span class="small muted">Details in Swedish</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--mint" id="prices">
    <div class="container split">
      <div>
        <p class="eyebrow">Prices</p>
        <h2>What does it cost?</h2>
        <p class="lead">All prices for private customers are what you pay after the RUT deduction, including VAT.</p>
        <ul class="check-list">
          <li>2 movers + truck: {PRICES.flytt.crews['2-1'].weekday} SEK/h weekdays, {PRICES.flytt.crews['2-1'].weekend} SEK/h weekends</li>
          <li>Typical two room apartment move: about {formatKr(twoRoom.price).replace('kr', 'SEK')}</li>
          <li>Move out cleaning: {PRICES.flyttstadning.perSqm} SEK/m² (60 m² = {(60 * PRICES.flyttstadning.perSqm).toLocaleString('sv-SE')} SEK)</li>
          <li>Windows: {PRICES.fonsterputs.window2} SEK each</li>
        </ul>
        <p>
          <a class="btn" href="/priser" hreflang="sv">Open the price calculator (Swedish) <Icon name="arrow" /></a>
        </p>
      </div>
      <div class="card">
        <h3>What is RUT?</h3>
        <p>
          RUT is a Swedish tax deduction for household services. You pay only half of the labour cost. We deduct it on the invoice and claim the rest from the
          Swedish Tax Agency. The limit is 75,000 SEK per person per year. You need a Swedish personal identity number (personnummer) and to pay tax in Sweden.
        </p>
        <p class="small muted">Without RUT, the cleaning prices are doubled. Ask us for a quote.</p>
      </div>
    </div>
  </section>

  <section class="section section--dark" id="guarantees">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Our guarantees</p>
        <h2>Promises in writing</h2>
      </div>
      <div class="grid grid-3">
        {
          guarantees.map(([icon, title, text]) => (
            <div class="g">
              <span class="icon-badge">
                <Icon name={icon} />
              </span>
              <h3>{title}</h3>
              <p>{text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--white" id="contact">
    <div class="container split">
      <div>
        <p class="eyebrow">Contact</p>
        <h2>Write to us in English</h2>
        <p class="lead">Tell us your addresses, apartment size and date. We reply {site.responseTime.replace('inom', 'within').replace('timmar', 'hours')}.</p>
        <ul class="contact">
          <li><a href={site.phoneHref}><Icon name="phone" /> {site.phone}</a></li>
          <li><a href={site.whatsappHref} rel="noopener"><Icon name="whatsapp" /> WhatsApp</a></li>
          <li><a href={`mailto:${site.email}`}><Icon name="mail" /> {site.email}</a></li>
        </ul>
      </div>
      <ContactForm lang="en" />
    </div>
  </section>
</Base>

<style>
  .en-hero {
    background: radial-gradient(900px 400px at 90% 0%, var(--green-100), transparent 65%), var(--bg);
  }
  .eyebrow :global(svg) {
    width: 16px;
    height: 16px;
  }
  .svc {
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
  }
  .svc:hover {
    box-shadow: var(--shadow);
  }
  .g {
    padding: 24px;
    border-radius: var(--radius);
    background: rgb(255 255 255 / 0.06);
    border: 1px solid rgb(255 255 255 / 0.12);
  }
  .g p {
    color: #c4dccd;
    margin: 0;
  }
  .g .icon-badge {
    background: rgb(34 197 94 / 0.16);
    color: var(--green-500);
  }
  .contact {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 10px;
  }
  .contact a {
    display: inline-flex;
    gap: 10px;
    align-items: center;
    font-weight: 600;
  }
  .contact :global(svg) {
    width: 20px;
    height: 20px;
  }
</style>
