---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import credits from '../data/image-credits.json';
import { img } from '../lib/images.js';
---
<Base
  title="Bildkällor och licenser"
  description="Alla foton på tostadflytt.se kommer från Pexels och är fria att använda kommersiellt. Här finns källa och licens för varje bild med länk till originalet."
  breadcrumbs={[{ name: 'Bildkällor', href: '/bildkallor' }]}
>
  <section class="section section--tight">
    <div class="container">
      <Breadcrumbs items={[{ name: 'Bildkällor', href: '/bildkallor' }]} />
      <h1>Bildkällor och licenser</h1>
      <p class="lead">
        Fotona på webbplatsen kommer från Pexels och används enligt Pexels licens, som tillåter kommersiell användning utan krav på namngivning. Vill du veta vem
        som tog en bild hittar du fotografens namn via länken till originalet.
      </p>
      <ul class="credits">
        {
          credits.map((c) => (
            <li>
              <Image src={img(c.file.replace('.jpg', ''))} alt="" width={160} height={110} />
              <div>
                <strong>{c.title}</strong>
                <span>
                  Pexels ·{' '}
                  <a href={c.licenseUrl} rel="noopener license">
                    Pexels licens
                  </a>{' '}
                  ·{' '}
                  <a href={c.landingUrl} rel="noopener">
                    Original och fotograf
                  </a>
                </span>
              </div>
            </li>
          ))
        }
      </ul>
      <p class="muted small">Logotypen tillhör {'TO Städ & Flytt AB'}.</p>
    </div>
  </section>
</Base>

<style>
  .credits {
    list-style: none;
    padding: 0;
    margin: 24px 0;
    display: grid;
    gap: 12px;
  }
  .credits li {
    display: flex;
    gap: 16px;
    align-items: center;
    padding: 12px;
    border-radius: var(--radius);
    background: #fff;
    border: 1px solid var(--line);
  }
  .credits :global(img) {
    width: 120px;
    height: 82px;
    object-fit: cover;
    border-radius: 10px;
    flex: none;
  }
  .credits div {
    display: grid;
    gap: 2px;
    font-size: 0.92rem;
  }
  .credits span {
    color: var(--ink-3);
  }
  @media (max-width: 520px) {
    .credits :global(img) {
      width: 84px;
      height: 64px;
    }
  }
</style>
