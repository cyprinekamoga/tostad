---
// Skadeanmälan med bilder (Netlify Forms, multipart).
import Icon from './Icon.astro';
---
<form name="skadeanmalan" method="POST" action="/tack?typ=skada" enctype="multipart/form-data" data-netlify="true" netlify-honeypot="bot-field" class="dmg" data-damage data-inbox>
  <input type="hidden" name="form-name" value="skadeanmalan" />
  <p class="visually-hidden"><label>Lämna tomt: <input name="bot-field" tabindex="-1" autocomplete="off" /></label></p>

  <div class="form-grid form-grid--2">
    <div class="field">
      <label for="d-name">Namn</label>
      <input id="d-name" name="namn" type="text" autocomplete="name" required />
    </div>
    <div class="field">
      <label for="d-phone">Telefon</label>
      <input id="d-phone" name="telefon" type="tel" autocomplete="tel" required />
    </div>
    <div class="field">
      <label for="d-email">Mejl</label>
      <input id="d-email" name="epost" type="email" autocomplete="email" required />
    </div>
    <div class="field">
      <label for="d-date">Datum för uppdraget</label>
      <input id="d-date" name="datum" type="date" required />
    </div>
    <div class="field">
      <label for="d-type">Gäller</label>
      <select id="d-type" name="typ">
        <option>Flytt</option>
        <option>Flyttstädning</option>
        <option>Hemstädning / storstädning</option>
        <option>Annat</option>
      </select>
    </div>
    <div class="field">
      <label for="d-addr">Adress där skadan upptäcktes</label>
      <input id="d-addr" name="adress" type="text" />
    </div>
  </div>
  <div class="field">
    <label for="d-desc">Vad har hänt?</label>
    <textarea id="d-desc" name="beskrivning" required placeholder="Beskriv skadan, vilket föremål det gäller och när du upptäckte den."></textarea>
  </div>
  <div class="field">
    <span class="lbl">Bilder på skadan <small class="muted">(max 3 bilder, totalt 8 MB)</small></span>
    <div class="uploads">
      {
        [1, 2, 3].map((n) => (
          <label class="upload">
            <input type="file" name={`bild${n}`} accept="image/*" />
            <span class="up-box">
              <Icon name="upload" />
              <span>Bild {n}</span>
            </span>
            <img class="preview" alt="" hidden />
          </label>
        ))
      }
    </div>
  </div>
  <label class="toggle consent">
    <input type="checkbox" name="samtycke" value="ja" required />
    <span>Jag godkänner att TO Städ & Flytt sparar uppgifterna för att hantera ärendet. <a href="/integritetspolicy">Integritetspolicy</a></span>
  </label>
  <button class="btn" type="submit">Skicka skadeanmälan <Icon name="arrow" /></button>
</form>

<style>
  .dmg {
    display: grid;
    gap: 18px;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: clamp(18px, 3vw, 30px);
    box-shadow: var(--shadow);
  }
  .lbl {
    font-weight: 600;
    font-size: 0.95rem;
  }
  .uploads {
    display: grid;
    gap: 10px;
    grid-template-columns: repeat(3, 1fr);
  }
  .upload {
    position: relative;
    aspect-ratio: 1;
    border-radius: 14px;
    overflow: hidden;
    cursor: pointer;
  }
  .upload input {
    position: absolute;
    inset: 0;
    opacity: 0;
    cursor: pointer;
    z-index: 2;
    min-height: 0;
  }
  .up-box {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 6px;
    border: 2px dashed var(--line);
    border-radius: 14px;
    color: var(--ink-3);
    font-size: 0.88rem;
    background: var(--bg);
  }
  .up-box :global(svg) {
    width: 26px;
    height: 26px;
  }
  .upload:focus-within .up-box {
    border-color: var(--green-600);
  }
  .preview {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .consent {
    align-items: flex-start;
    font-weight: 500;
  }
  .consent input {
    margin-top: 3px;
    flex: none;
  }
  .dmg > .btn {
    justify-self: start;
  }
</style>

<script>
  import { connectForm } from '../lib/inbox.js';

  document.querySelectorAll<HTMLFormElement>('form[data-inbox][name="skadeanmalan"]').forEach(connectForm);
  document.querySelectorAll<HTMLInputElement>('[data-damage] input[type="file"]').forEach((input) => {
    input.addEventListener('change', () => {
      const img = input.parentElement!.querySelector<HTMLImageElement>('.preview')!;
      const file = input.files?.[0];
      if (!file) {
        img.hidden = true;
        return;
      }
      img.src = URL.createObjectURL(file);
      img.hidden = false;
    });
  });
</script>
