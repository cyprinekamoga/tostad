---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Breadcrumbs from './Breadcrumbs.astro';
import Icon from './Icon.astro';
import { site } from '../config/site.js';

interface Props {
  h1: string;
  lead: string;
  image?: ImageMetadata;
  imageAlt?: string;
  crumbs?: { name: string; href: string }[];
  price?: string;
  priceNote?: string;
  primary?: { href: string; label: string };
  secondary?: { href: string; label: string };
  points?: string[];
}
const { h1, lead, image, imageAlt = '', crumbs = [], price, priceNote, primary, secondary, points = [] } = Astro.props;
---
<section class="page-hero">
  <div class="container split">
    <div>
      {crumbs.length > 0 && <Breadcrumbs items={crumbs} />}
      <h1>{h1}</h1>
      <p class="lead">{lead}</p>
      {
        price && (
          <p class="price-tag">
            <span class="from">Från</span> <strong>{price}</strong> {priceNote && <span class="note">{priceNote}</span>}
          </p>
        )
      }
      {
        points.length > 0 && (
          <ul class="check-list points">
            {points.map((p) => <li>{p}</li>)}
          </ul>
        )
      }
      <div class="btn-row">
        {primary && <a class="btn" href={primary.href}>{primary.label} <Icon name="arrow" /></a>}
        {secondary ? <a class="btn btn--ghost" href={secondary.href}>{secondary.label}</a> : <a class="btn btn--ghost" href={site.phoneHref}><Icon name="phone" /> {site.phone}</a>}
      </div>
    </div>
    {
      image && (
        <div class="media hero-media">
          <Picture src={image} alt={imageAlt} formats={['avif', 'webp']} widths={[640, 960, 1280, 1600]} sizes="(min-width: 900px) 46vw, 100vw" loading="eager" fetchpriority="high" />
        </div>
      )
    }
  </div>
</section>

<style>
  .page-hero {
    padding: clamp(28px, 4vw, 56px) 0 clamp(40px, 6vw, 72px);
    background: radial-gradient(1200px 400px at 85% -10%, var(--green-100), transparent 60%), var(--bg);
  }
  .price-tag {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 8px;
    padding: 10px 16px;
    border-radius: 14px;
    background: #fff;
    border: 1px solid var(--line);
    box-shadow: var(--shadow-sm);
  }
  .price-tag strong {
    font-size: 1.5rem;
    color: var(--green-800);
    letter-spacing: -0.02em;
  }
  .price-tag .from,
  .price-tag .note {
    color: var(--ink-3);
    font-size: 0.92rem;
  }
  .points {
    margin: 4px 0 24px;
  }
  .hero-media {
    aspect-ratio: 4 / 3;
  }
  .hero-media :global(picture),
  .hero-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
