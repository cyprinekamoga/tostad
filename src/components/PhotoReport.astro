---
// Exempel på fotorapporten kunden får efter flyttstädningen, bläddringsbar i en telefon.
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { img } from '../lib/images.js';

const rooms = [
  { image: 'kitchen-white', room: 'Kök', time: '14:32', points: '10/10', note: 'Ugn, fläkt, kyl och frys rengjorda invändigt och utvändigt.' },
  { image: 'oven', room: 'Ugn och spis', time: '14:35', points: '3/3', note: 'Plåtar, galler och lucka mellan glasen.' },
  { image: 'bathroom-white', room: 'Badrum', time: '15:48', points: '9/9', note: 'Avkalkat, golvbrunn rensad, fogar skurade.' },
  { image: 'empty-room', room: 'Vardagsrum', time: '16:20', points: '8/8', note: 'Lister, element, eluttag och fönsterbrädor.' },
  { image: 'empty-bedroom', room: 'Sovrum', time: '16:41', points: '8/8', note: 'Garderober invändigt och utvändigt, golv våttorkat.' },
];
---
<div class="report" data-report>
  <div class="phone">
    <div class="notch"></div>
    <div class="screen">
      <div class="r-head">
        <span class="r-badge"><Icon name="camera" /></span>
        <div>
          <strong>Fotorapport · Flyttstädning</strong>
          <span>Exempelgatan 12, Solna · exempel</span>
        </div>
      </div>
      <div class="r-track" data-report-track tabindex="0" aria-label="Rum i fotorapporten, svep för att bläddra">
        {
          rooms.map((r) => (
            <article class="r-card">
              <Image src={img(r.image)} alt={`${r.room} efter flyttstädning`} width={420} height={300} densities={[1, 2]} />
              <div class="r-meta">
                <span class="r-room">
                  <Icon name="check" /> {r.room}
                </span>
                <span class="r-time">Kl {r.time}</span>
              </div>
              <p>{r.note}</p>
              <span class="r-points">{r.points} punkter klara</span>
            </article>
          ))
        }
      </div>
      <div class="r-dots" aria-hidden="true">
        {rooms.map((_, i) => <span class:list={[i === 0 && 'on']} />)}
      </div>
      <div class="r-foot">
        <span>Skickad 19:12 till sara@exempel.se</span>
      </div>
    </div>
  </div>
  <div class="r-nav">
    <button type="button" class="btn btn--ghost btn--sm" data-report-prev aria-label="Föregående rum">←</button>
    <button type="button" class="btn btn--ghost btn--sm" data-report-next aria-label="Nästa rum">→</button>
  </div>
</div>

<style>
  .report {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    justify-items: center;
    gap: 14px;
  }
  .phone {
    position: relative;
    width: min(330px, 100%);
    border-radius: 44px;
    padding: 14px;
    background: #111c16;
    box-shadow: var(--shadow-lg), inset 0 0 0 2px #2a3a31;
  }
  .notch {
    position: absolute;
    top: 22px;
    left: 50%;
    width: 90px;
    height: 20px;
    margin-left: -45px;
    border-radius: 20px;
    background: #000;
    z-index: 2;
  }
  .screen {
    border-radius: 32px;
    background: #f5f8f6;
    overflow: hidden;
    padding: 48px 0 16px;
  }
  .r-head {
    display: flex;
    gap: 10px;
    align-items: center;
    padding: 0 16px 12px;
  }
  .r-head strong {
    display: block;
    font-size: 0.92rem;
    color: var(--green-950);
  }
  .r-head span {
    font-size: 0.75rem;
    color: var(--ink-3);
  }
  .r-badge {
    width: 38px;
    height: 38px;
    border-radius: 12px;
    display: grid;
    place-items: center;
    background: var(--green-700);
    color: #fff;
    flex: none;
  }
  .r-badge :global(svg) {
    width: 20px;
    height: 20px;
  }
  .r-track {
    display: flex;
    gap: 12px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding: 4px 16px 10px;
    scrollbar-width: none;
  }
  .r-track::-webkit-scrollbar {
    display: none;
  }
  .r-card {
    flex: 0 0 100%;
    scroll-snap-align: center;
    background: #fff;
    border-radius: 18px;
    border: 1px solid var(--line);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
  }
  .r-card :global(img) {
    width: 100%;
    aspect-ratio: 7 / 5;
    object-fit: cover;
  }
  .r-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 10px 12px 0;
    font-size: 0.85rem;
  }
  .r-room {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-weight: 700;
    color: var(--green-900);
  }
  .r-room :global(svg) {
    width: 16px;
    height: 16px;
    color: var(--green-600);
  }
  .r-time {
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
  }
  .r-card p {
    margin: 6px 12px 8px;
    font-size: 0.85rem;
    color: var(--ink-2);
    line-height: 1.45;
  }
  .r-points {
    display: inline-block;
    margin: 0 12px 12px;
    padding: 4px 10px;
    border-radius: 999px;
    background: var(--green-50);
    color: var(--green-800);
    font-size: 0.75rem;
    font-weight: 700;
  }
  .r-dots {
    display: flex;
    justify-content: center;
    gap: 6px;
  }
  .r-dots span {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #c9d8cf;
    transition: width 0.2s ease, background-color 0.2s ease;
  }
  .r-dots span.on {
    width: 20px;
    border-radius: 99px;
    background: var(--green-700);
  }
  .r-foot {
    text-align: center;
    font-size: 0.72rem;
    color: var(--ink-3);
    margin-top: 10px;
  }
  .r-nav {
    display: flex;
    gap: 10px;
  }
</style>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-report]')) {
    const track = root.querySelector<HTMLElement>('[data-report-track]')!;
    const dots = [...root.querySelectorAll<HTMLElement>('.r-dots span')];
    const cards = [...track.children] as HTMLElement[];
    const index = () => Math.round(track.scrollLeft / (cards[0].offsetWidth + 12));
    const go = (i: number) => track.scrollTo({ left: Math.max(0, Math.min(cards.length - 1, i)) * (cards[0].offsetWidth + 12), behavior: 'smooth' });
    track.addEventListener('scroll', () => {
      const i = index();
      dots.forEach((d, j) => d.classList.toggle('on', j === i));
    });
    root.querySelector('[data-report-prev]')?.addEventListener('click', () => go(index() - 1));
    root.querySelector('[data-report-next]')?.addEventListener('click', () => go(index() + 1));
    track.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') go(index() + 1);
      if (e.key === 'ArrowLeft') go(index() - 1);
    });
  }
</script>
