---
// Interaktiv demo av aviseringen via SMS: lastbilen kör längs kartan och SMS:en dyker upp i telefonen.
import Icon from './Icon.astro';

interface Props {
  price?: string;
}
const { price = '3 273 kr' } = Astro.props;
const messages = [
  { time: 'Kvällen före 18:00', text: `Hej Sara! Imorgon kl 08:00 kommer Ali och Jonas. Fast pris ${price}, inget tillkommer.` },
  { time: '07:42', text: 'Vi har åkt från Upplands Väsby. Följ bilen live via länken →' },
  { time: '07:58', text: 'Vi är framme om ca 5 minuter.' },
  { time: '08:03', text: 'Vi står utanför porten. Välkommen ner när du är redo!' },
];
---
<div class="track" data-track>
  <div class="map-card">
    <div class="map-head">
      <span class="live"><span class="dot"></span> Live</span>
      <span class="eta" data-eta>Framme om 21 min</span>
    </div>
    <svg viewBox="0 0 400 300" class="map" role="img" aria-label="Karta där flyttbilen kör från Upplands Väsby till Solna">
      <rect width="400" height="300" fill="#eef6f1" />
      <path d="M0 210 C 60 200, 90 250, 150 260 S 260 300, 400 280 V300 H0z" fill="#cfe8f5" />
      <path d="M250 0 C 260 40, 300 60, 330 40 S 380 10, 400 20 V0z" fill="#cfe8f5" />
      <g stroke="#ffffff" stroke-width="9" fill="none" stroke-linecap="round">
        <path d="M20 40 L 380 120" />
        <path d="M40 290 L 140 10" />
        <path d="M200 300 L 230 0" />
        <path d="M0 150 L 400 170" />
      </g>
      <path id="route" data-route d="M70 60 C 120 90, 140 120, 170 150 S 230 200, 260 205 S 320 230, 335 245" fill="none" stroke="#15803d" stroke-width="5" stroke-dasharray="2 10" stroke-linecap="round" />
      <g>
        <circle cx="70" cy="60" r="9" fill="#0b3d24" />
        <text x="84" y="52" font-size="13" font-weight="700" fill="#0b3d24" font-family="Inter Variable, Inter, sans-serif">Upplands Väsby</text>
        <circle cx="335" cy="245" r="9" fill="#16a34a" />
        <text x="270" y="275" font-size="13" font-weight="700" fill="#0b3d24" font-family="Inter Variable, Inter, sans-serif">Solna</text>
      </g>
      <g data-truck transform="translate(70 60)">
        <circle r="17" fill="#15803d" stroke="#fff" stroke-width="3" />
        <g transform="translate(-9 -9) scale(0.75)" stroke="#fff" stroke-width="2.2" fill="none" stroke-linecap="round" stroke-linejoin="round">
          <path d="M2 6h11v10H2zM13 10h4l4 4v2h-8z" /><circle cx="6" cy="18" r="2" /><circle cx="17" cy="18" r="2" />
        </g>
      </g>
    </svg>
    <button type="button" class="btn btn--sm btn--ghost replay" data-replay><Icon name="truck" /> Spela upp igen</button>
  </div>

  <div class="phone" aria-label="Exempel på SMS från TO Städ & Flytt">
    <div class="phone-notch"></div>
    <p class="phone-head"><strong>TO Städ & Flytt</strong><span>SMS · exempel</span></p>
    <ol class="msgs" data-msgs>
      {
        messages.map((m) => (
          <li class="msg">
            <span class="msg-time">{m.time}</span>
            <p>{m.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</div>

<style>
  .track {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 24px;
    align-items: center;
  }
  @media (min-width: 880px) {
    .track {
      grid-template-columns: minmax(0, 1.3fr) minmax(0, 0.9fr);
    }
  }
  .map-card {
    background: #fff;
    border-radius: var(--radius-lg);
    border: 1px solid var(--line);
    box-shadow: var(--shadow);
    padding: 16px;
    display: grid;
    gap: 12px;
  }
  .map-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-weight: 700;
  }
  .live {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--danger);
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .live .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--danger);
    animation: blink 1.2s ease-in-out infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0.3;
    }
  }
  .eta {
    color: var(--green-900);
    font-variant-numeric: tabular-nums;
  }
  .map {
    width: 100%;
    border-radius: 14px;
  }
  .replay {
    justify-self: start;
  }
  .phone {
    position: relative;
    margin-inline: auto;
    width: min(320px, 100%);
    min-height: 470px;
    border-radius: 42px;
    padding: 46px 16px 20px;
    background: #111c16;
    box-shadow: var(--shadow-lg), inset 0 0 0 2px #2a3a31;
  }
  .phone-notch {
    position: absolute;
    top: 14px;
    left: 50%;
    width: 96px;
    height: 22px;
    margin-left: -48px;
    border-radius: 20px;
    background: #000;
  }
  .phone-head {
    display: flex;
    flex-direction: column;
    align-items: center;
    color: #fff;
    margin: 0 0 14px;
    font-size: 0.9rem;
  }
  .phone-head span {
    color: #8fb3a0;
    font-size: 0.78rem;
  }
  .msgs {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }
  .msg {
    opacity: 0;
    transform: translateY(10px) scale(0.98);
    transition: opacity 0.35s ease, transform 0.35s ease;
  }
  .msg.show,
  :global(.no-js) .msg {
    opacity: 1;
    transform: none;
  }
  .msg-time {
    display: block;
    text-align: center;
    color: #8fb3a0;
    font-size: 0.72rem;
    margin-bottom: 4px;
  }
  .msg p {
    margin: 0;
    padding: 10px 13px;
    border-radius: 16px 16px 16px 4px;
    background: #24352b;
    color: #eaf6ef;
    font-size: 0.9rem;
    line-height: 1.4;
  }
</style>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-track]')) {
    const route = root.querySelector<SVGPathElement>('[data-route]')!;
    const truck = root.querySelector<SVGGElement>('[data-truck]')!;
    const eta = root.querySelector<HTMLElement>('[data-eta]')!;
    const msgs = [...root.querySelectorAll<HTMLElement>('.msg')];
    const len = route.getTotalLength();
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let raf = 0;
    let timers: number[] = [];

    function place(p: number) {
      const pt = route.getPointAtLength(len * p);
      truck.setAttribute('transform', `translate(${pt.x} ${pt.y})`);
      const mins = Math.max(0, Math.round(21 * (1 - p)));
      eta.textContent = p >= 1 ? 'Framme! Vi står utanför porten' : `Framme om ${mins} min`;
    }

    function play() {
      cancelAnimationFrame(raf);
      timers.forEach(clearTimeout);
      timers = [];
      msgs.forEach((m) => m.classList.remove('show'));
      if (reduce) {
        place(1);
        msgs.forEach((m) => m.classList.add('show'));
        return;
      }
      place(0);
      msgs[0]?.classList.add('show');
      timers.push(window.setTimeout(() => msgs[1]?.classList.add('show'), 900));
      const start = performance.now() + 1200;
      const dur = 6500;
      const step = (t: number) => {
        const p = Math.min(1, Math.max(0, (t - start) / dur));
        place(p);
        if (p > 0.72) msgs[2]?.classList.add('show');
        if (p >= 1) {
          msgs[3]?.classList.add('show');
          return;
        }
        raf = requestAnimationFrame(step);
      };
      raf = requestAnimationFrame(step);
    }

    root.querySelector('[data-replay]')?.addEventListener('click', play);
    const io = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          play();
          io.disconnect();
        }
      },
      { threshold: 0.35 },
    );
    io.observe(root);
  }
</script>
