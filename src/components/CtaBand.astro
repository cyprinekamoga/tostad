---
import Icon from './Icon.astro';
import { site } from '../config/site.js';

interface Props {
  title?: string;
  text?: string;
  href?: string;
  label?: string;
}
const {
  title = 'Vet du vad din flytt kostar? Det tar en minut.',
  text = 'Fast pris direkt, rutavdraget inräknat och betalning först när jobbet är klart.',
  href = '/priser',
  label = 'Räkna ut ditt fasta pris',
} = Astro.props;
---
<section class="cta-band">
  <div class="container inner reveal">
    <div>
      <h2>{title}</h2>
      <p>{text}</p>
    </div>
    <div class="btn-row">
      <a class="btn btn--light" href={href}>{label} <Icon name="arrow" /></a>
      <a class="btn btn--whatsapp" href={site.whatsappHref} rel="noopener"><Icon name="whatsapp" /> Skriv på WhatsApp</a>
    </div>
  </div>
</section>

<style>
  .cta-band {
    padding: clamp(40px, 6vw, 72px) 0;
    background: linear-gradient(120deg, var(--green-900), var(--green-800));
    color: #d9efe2;
  }
  .inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  h2 {
    color: #fff;
    margin-bottom: 8px;
    max-width: 22ch;
  }
  p {
    margin: 0;
    max-width: 52ch;
  }
</style>
