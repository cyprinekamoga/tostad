---
import '@fontsource-variable/inter/wght.css';
import '../styles/global.css';
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactDock from '../components/ContactDock.astro';
import { site } from '../config/site.js';
import { areas, counties } from '../data/areas.js';
import logo from '../assets/brand/logo.png';
import defaultOg from '../assets/images/hero-livingroom.jpg';

interface Crumb {
  name: string;
  href: string;
}
interface Props {
  title: string;
  description: string;
  image?: ImageMetadata;
  imageAlt?: string;
  noindex?: boolean;
  breadcrumbs?: Crumb[];
  jsonLd?: Record<string, unknown>[];
  lang?: 'sv' | 'en';
  alternates?: { lang: string; href: string }[];
  ogType?: string;
}

const {
  title,
  description,
  image = defaultOg,
  imageAlt = 'TO Städ & Flytt, flytt och städning i Stockholm',
  noindex = false,
  breadcrumbs = [],
  jsonLd = [],
  lang = 'sv',
  alternates = [],
  ogType = 'website',
} = Astro.props;

const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/').replace(/\/$/, '') || '/';
const canonical = new URL(path, site.url).href.replace(/\/$/, path === '/' ? '/' : '');
const og = await getImage({ src: image, width: 1200, height: 630, format: 'jpg', quality: 82, fit: 'cover' });
const ogUrl = new URL(og.src, site.url).href;
const logoImg = await getImage({ src: logo, width: 256, format: 'png' });
const logoUrl = new URL(logoImg.src, site.url).href;
const withBrand = `${title} | ${site.name}`;
const fullTitle = title.includes('TO Städ') || withBrand.length > 65 ? title : withBrand;

const orgId = `${site.url}/#foretag`;
const graph: Record<string, unknown>[] = [
  {
    '@type': ['LocalBusiness', 'MovingCompany'],
    '@id': orgId,
    name: site.name,
    legalName: site.legalName,
    url: site.url,
    logo: logoUrl,
    image: ogUrl,
    telephone: site.phoneHref.replace('tel:', ''),
    email: site.email,
    identifier: { '@type': 'PropertyValue', propertyID: 'Organisationsnummer', value: site.orgNr },
    address: {
      '@type': 'PostalAddress',
      streetAddress: site.address.street,
      postalCode: site.address.postalCode,
      addressLocality: site.address.city,
      addressRegion: site.address.region,
      addressCountry: site.address.country,
    },
    areaServed: [...counties.map((c) => ({ '@type': 'AdministrativeArea', name: c.name })), ...areas.map((a) => ({ '@type': 'City', name: a.name }))],
    priceRange: '125 till 1 145 kr/h efter RUT',
    paymentAccepted: 'Faktura, kort',
    currenciesAccepted: 'SEK',
    knowsLanguage: ['sv', 'en'],
    ...(site.reviews.googleMapsUrl && { hasMap: site.reviews.googleMapsUrl }),
    sameAs: [site.reviews.googleMapsUrl, site.reviews.recoUrl, site.social.facebook, site.social.instagram].filter(Boolean),
  },
  {
    '@type': 'WebSite',
    '@id': `${site.url}/#webbplats`,
    url: site.url,
    name: site.name,
    inLanguage: 'sv-SE',
    publisher: { '@id': orgId },
  },
  {
    '@type': 'WebPage',
    '@id': `${canonical}#sida`,
    url: canonical,
    name: fullTitle,
    description,
    inLanguage: lang === 'en' ? 'en' : 'sv-SE',
    isPartOf: { '@id': `${site.url}/#webbplats` },
    about: { '@id': orgId },
    primaryImageOfPage: ogUrl,
  },
];
if (breadcrumbs.length) {
  graph.push({
    '@type': 'BreadcrumbList',
    itemListElement: [{ name: 'Hem', href: '/' }, ...breadcrumbs].map((c, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: c.name,
      item: new URL(c.href, site.url).href.replace(/\/$/, c.href === '/' ? '/' : ''),
    })),
  });
}
const ld = { '@context': 'https://schema.org', '@graph': [...graph, ...jsonLd] };
---
<!doctype html>
<html lang={lang === 'en' ? 'en' : 'sv'} class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={new URL(a.href, site.url).href} />)}
    <meta name="theme-color" content="#0b3d24" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon-48.png" type="image/png" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={lang === 'en' ? 'en_GB' : 'sv_SE'} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content={String(og.attributes.width ?? 1200)} />
    <meta property="og:image:height" content={String(og.attributes.height ?? 630)} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />
    <script is:inline>document.documentElement.classList.replace('no-js', 'js');</script>
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  </head>
  <body>
    <a class="skip-link" href="#main">{lang === 'en' ? 'Skip to content' : 'Hoppa till innehållet'}</a>
    <Header lang={lang} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
    <ContactDock lang={lang} />
    <script>
      // Mjuka animationer när sektioner kommer in i bild.
      const els = document.querySelectorAll('.reveal');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('is-visible');
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
        );
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add('is-visible'));
      }
    </script>
  </body>
</html>
